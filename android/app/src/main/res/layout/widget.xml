<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 3×1 (TimeWidgetProvider.java): abgerundeter Kasten mittig in der Zeile.
  Oben Arbeitgeber und laufende Zeit, darunter Start bzw. Pause/Weiter und Beenden.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_name_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:text="●"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingEnd="6dp"
                    android:text="▾"
                    android:textColor="@color/widget_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Chronometer
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_start"
                style="@style/WidgetButton"
                android:background="@drawable/widget_btn_primary"
                android:contentDescription="Zeit starten">

                <ImageView style="@style/WidgetButtonIcon" android:src="@drawable/ic_widget_play" />

                <TextView style="@style/WidgetButtonLabel" android:text="Start" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_pause"
                style="@style/WidgetButton"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_btn_warning"
                android:contentDescription="Pause">

                <ImageView
                    android:id="@+id/widget_pause_icon"
                    style="@style/WidgetButtonIcon"
                    android:src="@drawable/ic_widget_pause" />

                <TextView
                    android:id="@+id/widget_pause_label"
                    style="@style/WidgetButtonLabel"
                    android:text="Pause" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_stop"
                style="@style/WidgetButton"
                android:background="@drawable/widget_btn_danger"
                android:contentDescription="Zeit beenden">

                <ImageView style="@style/WidgetButtonIcon" android:src="@drawable/ic_widget_stop" />

                <TextView style="@style/WidgetButtonLabel" android:text="Beenden" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
