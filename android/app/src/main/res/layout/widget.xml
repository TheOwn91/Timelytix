<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 3×1 (TimeWidgetProvider.java) nach Material 3: deckende Fläche mit dem Eckenradius des Systems
  (@android:id/background + clipToOutline, ab Android 12), Knöpfe als Kapseln mit 48 dp Höhe.
  Oben Arbeitgeber und laufende Zeit (nimmt den freien Platz ein), darunter Start bzw. Pause/Weiter und Beenden.
  Die Grundwerte (Name, nur „Start“) zeigt die Vorschau in der Widget-Auswahl; sonst setzt sie TimeWidgetProvider.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_name_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="●"
                    android:textColor="@color/widget_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_name"
                    android:text="Timelytix"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_muted"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/widget_chevron"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_expand"
                    android:tint="@color/widget_muted" />
            </LinearLayout>

            <!-- Rechts: Uhrzeit (TextClock zählt von selbst) bzw. Arbeitszeit, beim Arbeiten die Uhrzeit klein davor
                 (in einer Zeile – übereinander passt es bei einer Zeile Widget-Höhe nicht neben die 48-dp-Knöpfe) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:baselineAligned="true"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/widget_now_small"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:format12Hour="HH:mm:ss"
                    android:format24Hour="HH:mm:ss"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="13sp" />

                <Chronometer
                    android:id="@+id/widget_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="24sp" />

                <TextClock
                    android:id="@+id/widget_now_big"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="HH:mm:ss"
                    android:format24Hour="HH:mm:ss"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_start"
                style="@style/WidgetButton"
                android:background="@drawable/widget_btn_primary"
                android:contentDescription="Zeit starten">

                <ImageView
                    style="@style/WidgetButtonIcon"
                    android:src="@drawable/ic_widget_play"
                    android:tint="@color/widget_on_primary" />

                <TextView
                    style="@style/WidgetButtonLabel"
                    android:text="Start"
                    android:textColor="@color/widget_on_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_pause"
                style="@style/WidgetButton"
                android:visibility="gone"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_warning"
                android:contentDescription="Pause">

                <ImageView
                    android:id="@+id/widget_pause_icon"
                    style="@style/WidgetButtonIcon"
                    android:src="@drawable/ic_widget_pause"
                    android:tint="@color/widget_on_warning" />

                <TextView
                    android:id="@+id/widget_pause_label"
                    style="@style/WidgetButtonLabel"
                    android:text="Pause"
                    android:textColor="@color/widget_on_warning" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_stop"
                style="@style/WidgetButton"
                android:visibility="gone"
                android:background="@drawable/widget_btn_danger"
                android:contentDescription="Zeit beenden">

                <ImageView
                    style="@style/WidgetButtonIcon"
                    android:src="@drawable/ic_widget_stop"
                    android:tint="@color/widget_on_danger" />

                <TextView
                    style="@style/WidgetButtonLabel"
                    android:text="Beenden"
                    android:textColor="@color/widget_on_danger" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
