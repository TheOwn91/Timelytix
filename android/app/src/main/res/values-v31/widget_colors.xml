<?xml version="1.0" encoding="utf-8"?>
<!--
  Ab Android 12: Fläche, Text und Start-Knopf in den Systemfarben (dynamische Farben aus dem Hintergrundbild),
  wie es die Widget-Richtlinien empfehlen. Pause und Beenden behalten ihre festen Bedeutungsfarben.
  Töne nach Material 3: surface = neutral 95, primary = Ton 40, Text auf primary = Ton 100.
-->
<resources>
    <color name="widget_bg">@android:color/system_neutral1_50</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_muted">@android:color/system_neutral2_700</color>
    <color name="widget_primary">@android:color/system_accent1_600</color>
    <color name="widget_on_primary">@android:color/system_accent1_0</color>
    <color name="widget_warning">#FFDBCC</color>
    <color name="widget_on_warning">#351000</color>
    <color name="widget_danger">#BA1A1A</color>
    <color name="widget_on_danger">#FFFFFF</color>
</resources>
